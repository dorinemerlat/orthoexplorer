params {
    species             = '${projectDir}/species.csv'
    outgroups           = '${projectDir}/outgroups.csv'
    groups              = '' # List of outgroups (example: 'Diplopoda,Chilopoda,Hexapoda,Crustacea,Chelicerata')
    colors              = '${projectDir}/colors.yaml' # optional
}

process {
    executor = 'slurm'
    queue = "" // Fill the partition name
    cache = true // Cache temporary files to speed up reruns
    clusterOptions = ''
    queue = { task.time > 24.h ? 'long' : 'fast' }
}

// Load base.config by default for all pipelines
includeConfig "$projectDir/conf/modules.config"